# Copie este arquivo para .env e preencha os valores

NODE_ENV=production

# Senha de acesso ao dashboard
DASHBOARD_USER=artezian
DASHBOARD_PASS=troque_essa_senha

# JSONbin.io — storage dos dados (parceiros, custos, histórico)
# Crie conta grátis em jsonbin.io → API Keys → copie a Master Key
# Depois crie um bin em jsonbin.io/app/collections e copie o ID
JSONBIN_KEY=sua_master_key_aqui
JSONBIN_ID=seu_bin_id_aqui

# API Stays
STAYS_BASE_URL=https://artezian.stays.net
STAYS_AUTH_BASE64=NWI1YmU2NTY6ZmU0OGU3MzA=

# API Datacrazy
DATACRAZY_BASE_URL=https://api.g1.datacrazy.io
DATACRAZY_API_KEY=sua_chave_aqui
